<launch>
  <!-- Launch file for robosense Airy LiDAR -->

    <arg name="rviz" default="true" />

    <rosparam command="load" file="$(find fast_lio)/config/agrilira4d.yaml" />

    <param name="feature_extract_enable" type="bool" value="0"/>
    <param name="point_filter_num" type="int" value="1"/>
    <param name="max_iteration" type="int" value="5" />
    <param name="filter_size_surf" type="double" value="0.5" />
    <param name="filter_size_map" type="double" value="0.5" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="0" />

    <!--
      camera_init_flu 为父系，camera_init 为子系。
      该 -90° Z 轴旋转与配置中的 R_camera_init_flu_camera_init 一致。
    -->
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="camera_init_flu_to_camera_init_tf"
          args="0 0 0 0 0 -0.7071067811865476 0.7071067811865476 camera_init_flu camera_init" />

    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz_fast_lio" args="-d $(find fast_lio)/rviz_cfg/fast_lio_robosense.rviz" />
    </group>

</launch>
